# Environment mode. Read since roadmap phase 0 (config/env_settings.py):
# APP_ENV=production enables strict startup checks — the process aborts on a
# weak JWT_SECRET_KEY or a missing BOOTSTRAP_SUPERADMIN_PASSWORD. Any other
# value means development: the same checks only log a warning.
APP_ENV=docker
# JWT authentication
# Change JWT_SECRET_KEY to a random 32+ byte value before deploying.
# Default is intentionally weak — suitable only for local development, and
# rejected outright when APP_ENV=production.
JWT_SECRET_KEY=anpr-default-secret-change-me
# Password of the superadmin created on first start, while the users table is
# still empty (login: superadmin). Required when APP_ENV=production; left empty
# in development the seed falls back to "1234" and logs a warning.
BOOTSTRAP_SUPERADMIN_PASSWORD=
# Bootstrap log level (read since roadmap phase 4): applies from process start
# until settings are first read from the database; after that the level stored
# in app_settings (`logging.level`, editable in the UI) takes over.
LOG_LEVEL=INFO
# Directory for log files: a mount point (logs_data volume), not a UI setting.
ANPR_LOGS_DIR=/app/logs
# Directory for screenshots and export files: a mount point (media_data
# volume), not a UI setting. Read since roadmap phase 5.
ANPR_MEDIA_DIR=data/screenshots
# Model weights inside the image and the inference device (cpu or cuda).
ANPR_YOLO_MODEL_PATH=anpr/models/yolo/best.pt
ANPR_OCR_MODEL_PATH=anpr/models/ocr_crnn/crnn_ocr_model_int8_fx.pth
ANPR_DEVICE=cpu
# PostgreSQL connection pool bounds and the screenshot I/O worker count.
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
ANPR_IO_POOL_WORKERS=2
# Comma-separated browser origins allowed to call this API cross-origin
# (third-party dashboards, integration UIs). Leave empty to disable
# cross-origin browser access entirely — the bundled web UI is served
# same-origin and is unaffected either way. Does NOT restrict non-browser
# clients (server-to-server integrations, curl); CORS is browser-only.
# Example: CORS_ALLOWED_ORIGINS=https://dash.example.com,https://partner.example.org
CORS_ALLOWED_ORIGINS=
HTTP_PORT=8080
POSTGRES_DB=anpr
POSTGRES_USER=anpr
POSTGRES_PASSWORD=anpr
# Host port the postgres container publishes (consumer: docker-compose.yml)
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql://anpr:anpr@postgres:5432/anpr
# Thread limits for PyTorch/OpenMP/MKL (prevents CPU oversubscription with multiple channels)
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
