APP_ENV=docker
# JWT authentication
# Change JWT_SECRET_KEY to a random 32+ byte value before deploying.
# Default is intentionally weak — suitable only for local development.
JWT_SECRET_KEY=anpr-default-secret-change-me
JWT_EXPIRATION_MINUTES=480
DEBUG=false
LOG_LEVEL=INFO
SETTINGS_PATH=/app/config/settings.yaml
# Comma-separated browser origins allowed to call this API cross-origin
# (third-party dashboards, integration UIs). Leave empty to disable
# cross-origin browser access entirely — the bundled web UI is served
# same-origin and is unaffected either way. Does NOT restrict non-browser
# clients (server-to-server integrations, curl); CORS is browser-only.
# Example: CORS_ALLOWED_ORIGINS=https://dash.example.com,https://partner.example.org
CORS_ALLOWED_ORIGINS=
HTTP_PORT=8080
POSTGRES_DB=anpr
POSTGRES_USER=anpr
POSTGRES_PASSWORD=anpr
POSTGRES_DSN=postgresql://anpr:anpr@postgres:5432/anpr
# Thread limits for PyTorch/OpenMP/MKL (prevents CPU oversubscription with multiple channels)
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
