# Режим окружения. Используется начиная с фазы 0 дорожной карты (config/env_settings.py):
# APP_ENV=production включает строгие проверки при запуске — процесс прерывается
# при слабом JWT_SECRET_KEY или отсутствующем SUPERADMIN_PASSWORD. Любое другое
# значение означает режим разработки: те же проверки лишь записывают предупреждение в лог.
APP_ENV=docker
# Аутентификация JWT
# Перед развёртыванием замените JWT_SECRET_KEY на случайное значение длиной 32+ байта.
# Значение по умолчанию намеренно слабое — подходит только для локальной разработки и
# полностью отклоняется при APP_ENV=production.
JWT_SECRET_KEY=anpr-default-secret-change-me
# Пароль технического суперадмина (логин: superadmin) — читается из окружения при
# каждом входе, у суперадмина нет строки в таблице users. Обязателен при
# APP_ENV=production; если оставить пустым в режиме разработки, используется "1234"
# и записывается предупреждение в лог. Смена значения применяется после перезапуска.
SUPERADMIN_PASSWORD=
# Уровень логирования при начальной загрузке (используется начиная с фазы 4 дорожной карты): применяется с момента запуска
# процесса до первого чтения настроек из базы данных; после этого в силу вступает уровень,
# хранящийся в app_settings (logging.level, редактируется в UI).
#LOG_LEVEL=INFO
# Каталог для файлов логов: точка монтирования (том logs_data), а не настройка UI.
ANPR_LOGS_DIR=/app/logs
# Каталог для скриншотов и файлов экспорта: точка монтирования (том media_data),
# а не настройка UI. Используется начиная с фазы 5 дорожной карты.
ANPR_MEDIA_DIR=data/screenshots
# Веса моделей внутри образа и устройство для инференса (cpu или cuda).
ANPR_YOLO_MODEL_PATH=anpr/models/yolo/best.pt
ANPR_OCR_MODEL_PATH=anpr/models/ocr_crnn/crnn_ocr_model_int8_fx.pth
ANPR_DEVICE=cpu
# Границы пула соединений PostgreSQL и число воркеров ввода-вывода для скриншотов.
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
ANPR_IO_POOL_WORKERS=2
# Разделённый запятыми список источников (origin) браузера, которым разрешено обращаться к этому API кросс-доменно
# (сторонние дашборды, интерфейсы интеграций). Оставьте пустым, чтобы полностью
# отключить кросс-доменный доступ из браузера — встроенный веб-интерфейс
# обслуживается с того же источника и в любом случае не затрагивается. НЕ ограничивает
# небраузерных клиентов (серверные интеграции, curl); CORS действует только в браузере.
# Пример: CORS_ALLOWED_ORIGINS=https://dash.example.com,https://partner.example.org
CORS_ALLOWED_ORIGINS=
HTTP_PORT=8080
POSTGRES_DB=anpr
POSTGRES_USER=anpr
POSTGRES_PASSWORD=anpr
# Хост-порт, публикуемый контейнером postgres (потребитель: docker-compose.yml)
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql://anpr:anpr@postgres:5432/anpr
# Ограничения числа потоков для PyTorch/OpenMP/MKL (предотвращает избыточное выделение CPU при нескольких каналах)
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
